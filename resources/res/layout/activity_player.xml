<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/walkman_black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.extremestudios.musicmanevo.BackgroundPatternView
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <ImageButton
                android:id="@+id/btn_back_player"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@android:drawable/ic_menu_revert"
                android:tint="@color/neon_purple"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/neon_purple"
                android:id="@+id/player_header_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MUSICMAN EVO"
                android:layout_centerInParent="true"
                android:letterSpacing="0.2"/>
            <ImageButton
                android:id="@+id/btn_go_to_eq"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@android:drawable/ic_menu_sort_by_size"
                android:tint="@color/neon_purple"
                android:layout_centerVertical="true"
                android:rotation="90"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <FrameLayout
            android:id="@+id/logo_container"
            android:background="@color/walkman_grey"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="5dp"
            android:layout_below="@+id/header"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/player_logo_display"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:src="@drawable/logo_wave_evo"
                android:tint="@color/neon_purple"/>
        </FrameLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/advanced_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_below="@+id/logo_container"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <Button
                    android:textSize="10sp"
                    android:textColor="@color/white"
                    android:id="@+id/btn_ab_repeat"
                    android:padding="0dp"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="A-B OFF"
                    android:backgroundTint="@color/walkman_grey"
                    style="?android:attr/buttonBarButtonStyle"/>
                <View
                    android:layout_width="20dp"
                    android:layout_height="1dp"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@color/walkman_grey"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">
                    <TextView
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="@color/neon_purple"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PITCH"/>
                    <Button
                        android:textColor="@color/white"
                        android:id="@+id/btn_pitch_minus"
                        android:padding="0dp"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:text="-"
                        android:backgroundTint="@android:color/transparent"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:id="@+id/tv_pitch_value"
                        android:layout_width="30dp"
                        android:layout_height="wrap_content"
                        android:text="0"/>
                    <Button
                        android:textColor="@color/white"
                        android:id="@+id/btn_pitch_plus"
                        android:padding="0dp"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:text="+"
                        android:backgroundTint="@android:color/transparent"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@color/walkman_grey"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">
                    <TextView
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="@color/neon_purple"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SPEED"/>
                    <Button
                        android:textColor="@color/white"
                        android:id="@+id/btn_speed_minus"
                        android:padding="0dp"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:text="-"
                        android:backgroundTint="@android:color/transparent"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:id="@+id/tv_speed_value"
                        android:layout_width="40dp"
                        android:layout_height="wrap_content"
                        android:text="1.0x"/>
                    <Button
                        android:textColor="@color/white"
                        android:id="@+id/btn_speed_plus"
                        android:padding="0dp"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:text="+"
                        android:backgroundTint="@android:color/transparent"/>
                </LinearLayout>
                <View
                    android:layout_width="20dp"
                    android:layout_height="1dp"/>
                <ImageButton
                    android:id="@+id/btn_rewind_5"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="8dp"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@android:drawable/ic_media_rew"
                    android:tint="@color/neon_purple"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="@color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5s"/>
                <ImageButton
                    android:id="@+id/btn_forward_5"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="8dp"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@android:drawable/ic_media_ff"
                    android:tint="@color/neon_purple"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/extra_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_below="@+id/advanced_controls">
            <ImageButton
                android:id="@+id/btn_shuffle"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_shuffle"
                android:tint="@color/white"/>
            <ImageButton
                android:id="@+id/btn_repeat"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_rotate"
                android:tint="@color/white"
                android:layout_marginStart="40dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/info_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_below="@+id/extra_controls"
            android:paddingStart="32dp"
            android:paddingEnd="32dp">
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:ellipsize="marquee"
                android:id="@+id/player_song_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Song Title"
                android:singleLine="true"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/neon_purple"
                android:id="@+id/player_artist_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Artist Name"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/progress_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_below="@+id/info_container"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">
            <SeekBar
                android:id="@+id/player_seekbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:progressTint="@color/neon_purple"
                android:thumbTint="@color/neon_purple"/>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp">
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/white"
                    android:id="@+id/tv_current_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:00"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/white"
                    android:id="@+id/tv_total_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4:20"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
        </LinearLayout>
        <RelativeLayout
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:layout_below="@+id/progress_container"
            android:layout_alignParentBottom="true">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageButton
                    android:id="@+id/btn_prev"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@android:drawable/ic_media_previous"
                    android:tint="@color/neon_purple"/>
                <FrameLayout
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp">
                    <View
                        android:background="@drawable/circular_control_bg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                    <ImageButton
                        android:layout_gravity="center"
                        android:id="@+id/btn_play_pause"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:src="@android:drawable/ic_media_play"
                        android:tint="@color/walkman_black"/>
                </FrameLayout>
                <ImageButton
                    android:id="@+id/btn_next"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@android:drawable/ic_media_next"
                    android:tint="@color/neon_purple"/>
            </LinearLayout>
        </RelativeLayout>
    </RelativeLayout>
</FrameLayout>
