<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:ads="http://schemas.android.com/apk/res-auto"
    android:background="@color/walkman_black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.extremestudios.musicmanevo.BackgroundPatternView
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:background="@color/walkman_grey"
            android:layout_width="match_parent"
            android:layout_height="80dp">
            <TextView
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/neon_purple"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MUSICMAN EVO"
                android:layout_centerVertical="true"
                android:layout_marginStart="20dp"
                android:letterSpacing="0.1"/>
            <View
                android:background="@color/neon_purple"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
        <ListView
            android:id="@+id/menu_list"
            android:background="@android:color/transparent"
            android:padding="10dp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:listSelector="@color/walkman_light_grey"
            android:divider="@color/walkman_light_grey"
            android:dividerHeight="1dp"
            android:layout_weight="1"/>
        <RelativeLayout
            android:id="@+id/mini_player"
            android:background="@color/walkman_grey"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="80dp">
            <View
                android:background="@color/neon_purple"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <ImageView
                android:id="@+id/mini_album_art"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="0dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="20dp">
                <TextView
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:id="@+id/mini_song_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Musicman Evo"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/neon_purple"
                    android:id="@+id/mini_artist_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Extreme Studios"/>
            </LinearLayout>
            <ImageButton
                android:id="@+id/mini_play_pause"
                android:background="@drawable/circular_control_bg"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@android:drawable/ic_media_play"
                android:tint="@color/walkman_black"
                android:layout_centerVertical="true"
                android:layout_marginEnd="15dp"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/banner_container"
            android:background="@color/walkman_grey"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.gms.ads.AdView
                android:id="@+id/bottom_banner_ad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                ads:adSize="BANNER"
                ads:adUnitId="ca-app-pub-8451272966172172/1079409846"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
