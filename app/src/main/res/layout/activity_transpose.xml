<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center" android:orientation="vertical" android:padding="24dp"
    android:background="@color/walkman_black" android:layout_width="match_parent" android:layout_height="match_parent">
    <TextView android:text="TRANSPOSE" android:textColor="@color/neon_purple" android:textSize="20sp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <TextView android:id="@+id/transpose_value" android:textColor="@color/white" android:textSize="32sp" android:layout_margin="20dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <LinearLayout android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content">
        <Button android:id="@+id/transpose_minus" android:text="-" android:layout_width="80dp" android:layout_height="wrap_content" />
        <Button android:id="@+id/transpose_plus" android:text="+" android:layout_width="80dp" android:layout_height="wrap_content" />
    </LinearLayout>
    <Button android:id="@+id/transpose_reset" android:text="RESET" android:layout_width="160dp" android:layout_height="wrap_content" />
</LinearLayout>
