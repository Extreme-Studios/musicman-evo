<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/walkman_black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.extremestudios.musicmanevo.BackgroundPatternView
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:background="@color/walkman_grey"
            android:layout_width="match_parent"
            android:layout_height="60dp">
            <ImageButton
                android:id="@+id/btn_back_eq"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@android:drawable/ic_menu_revert"
                android:tint="@color/neon_purple"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/neon_purple"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EQUALIZER"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="?android:attr/buttonBarStyle">
            <Button
                android:textColor="@color/white"
                android:id="@+id/btn_preset_jazz"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="JAZZ"
                android:layout_weight="1"
                android:backgroundTint="@color/walkman_grey"
                style="?android:attr/buttonBarButtonStyle"/>
            <Button
                android:textColor="@color/white"
                android:id="@+id/btn_preset_rock"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="ROCK"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:backgroundTint="@color/walkman_grey"
                style="?android:attr/buttonBarButtonStyle"/>
            <Button
                android:textColor="@color/white"
                android:id="@+id/btn_preset_reset"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="RESET"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:backgroundTint="@color/walkman_grey"
                style="?android:attr/buttonBarButtonStyle"/>
        </LinearLayout>
        <ScrollView
            android:background="@android:color/transparent"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="15dp">
                    <TextView
                        android:textStyle="bold"
                        android:textColor="@color/neon_purple"
                        android:layout_gravity="center"
                        android:id="@+id/text_gain_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Master Gain (0 dB)"/>
                    <SeekBar
                        android:id="@+id/seek_gain"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:max="2000"
                        android:progress="0"
                        android:progressTint="@color/neon_purple"
                        android:thumbTint="@color/neon_purple"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@color/walkman_grey"
                    android:padding="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="25dp">
                    <TextView
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:layout_gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="Global Equalizer Control"/>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <Button
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:id="@+id/btn_global_minus"
                            android:padding="0dp"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:text="-"
                            android:backgroundTint="@color/neon_purple"/>
                        <TextView
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="LEVEL"
                            android:layout_marginStart="24dp"
                            android:layout_marginEnd="24dp"/>
                        <Button
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:id="@+id/btn_global_plus"
                            android:padding="0dp"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:text="+"
                            android:backgroundTint="@color/neon_purple"/>
                    </LinearLayout>
                </LinearLayout>
                <View
                    android:background="@color/walkman_grey"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginBottom="20dp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/bands_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
