<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/walkman_black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.extremestudios.musicmanevo.BackgroundPatternView
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:layout_width="280dp"
            android:layout_height="280dp">
            <View
                android:layout_gravity="center"
                android:id="@+id/pulse_circle_1"
                android:background="@drawable/circle_pulse"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:alpha="0.6"/>
            <View
                android:layout_gravity="center"
                android:id="@+id/pulse_circle_2"
                android:background="@drawable/circle_pulse"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:alpha="0.6"/>
            <View
                android:layout_gravity="center"
                android:id="@+id/pulse_circle_3"
                android:background="@drawable/circle_pulse"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:alpha="0.6"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/splash_logo"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:src="@drawable/logo_wave_evo"
                android:tint="#ff00ff"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">
            <TextView
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:id="@+id/txt_musicman"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MUSICMAN"
                android:letterSpacing="0.05"/>
            <TextView
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="#ff00ff"
                android:id="@+id/txt_evo"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EVO"
                android:layout_marginStart="8dp"
                android:letterSpacing="0.05"/>
        </LinearLayout>
        <TextView
            android:textSize="16sp"
            android:textColor="#ff00ff"
            android:id="@+id/txt_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="your music evolved."
            android:alpha="0"
            android:letterSpacing="0.05"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp">
        <TextView
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Powered by EXTREME STUDIOS"
            android:alpha="0.5"
            android:letterSpacing="0.1"/>
        <TextView
            android:textSize="9sp"
            android:textColor="@color/white"
            android:id="@+id/txt_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Version"
            android:alpha="0.4"/>
    </LinearLayout>
</FrameLayout>
