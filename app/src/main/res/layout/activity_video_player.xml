<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:padding="16dp"
    android:background="@color/walkman_black" android:layout_width="match_parent" android:layout_height="match_parent">
    <VideoView android:id="@+id/video_view" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <Button android:id="@+id/video_open" android:text="OPEN VIDEO" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <Button android:id="@+id/video_play" android:text="PLAY / PAUSE" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
        <Button android:id="@+id/video_equalizer" android:text="EQUALIZER" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
        <Button android:id="@+id/video_transpose" android:text="TRANSPOSE" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>
